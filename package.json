{
  "name": "incidentlens-ai",
  "version": "1.0.0",
  "description": "IncidentLens AI is a serverless, AI-assisted incident intelligence platform designed to help software engineers and Site Reliability Engineers detect, understand, and respond to application failures faster.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch apps/demo-api/src/server.ts",
    "dev:processor": "tsx scripts/invoke-processor-local.ts",
    "build": "tsc",
    "build:lambda": "node scripts/package-lambda.mjs",
    "build:api-lambda": "node scripts/package-lambda.mjs api",
    "build:processor": "node scripts/package-lambda.mjs processor",
    "start": "node dist/apps/demo-api/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:processor": "vitest run apps/incident-processor",
    "test:terraform": "./scripts/test-terraform.sh",
    "test:lambda-package": "./scripts/validate-lambda-package.sh",
    "test:smoke": "./scripts/smoke-test-deployment.sh",
    "test:subscription-delivery": "./scripts/verify-log-subscription-delivery.sh",
    "test:automatic-incident-creation": "./scripts/verify-automatic-incident-creation.sh",
    "test:idempotent-processing": "./scripts/verify-idempotent-processing.sh",
    "test:pipeline-local": "vitest run apps/incident-processor/tests/pipeline-integration.test.ts",
    "test:incident-pipeline": "./scripts/verify-incident-pipeline.sh",
    "test:ai-enrichment": "./scripts/verify-ai-incident-enrichment.sh",
    "smoke:bedrock": "tsx scripts/smoke-bedrock-analyzer.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardinhoo/incidentlens-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/gerardinhoo/incidentlens-ai/issues"
  },
  "homepage": "https://github.com/gerardinhoo/incidentlens-ai#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1106.0",
    "@aws-sdk/client-dynamodb": "^3.1097.0",
    "@aws-sdk/lib-dynamodb": "^3.1097.0",
    "@fastify/aws-lambda": "^6.4.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1"
  }
}
