{
  "name": "incidentlens-ai",
  "version": "1.0.0",
  "description": "IncidentLens AI is a serverless, AI-assisted incident intelligence platform designed to help software engineers and Site Reliability Engineers detect, understand, and respond to application failures faster.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch apps/demo-api/src/server.ts",
    "build": "tsc",
    "start": "node dist/apps/demo-api/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerardinhoo/incidentlens-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "bugs": {
    "url": "https://github.com/gerardinhoo/incidentlens-ai/issues"
  },
  "homepage": "https://github.com/gerardinhoo/incidentlens-ai#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
