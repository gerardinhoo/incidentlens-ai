# Copy to terraform.tfvars (gitignored) and adjust as needed:
#   cp terraform.tfvars.example terraform.tfvars

project_name                         = "incidentlens"
environment                          = "dev"
aws_region                           = "us-east-1"
log_retention_days                   = 30
artifact_bucket_force_destroy        = false
dynamodb_deletion_protection_enabled = false
lambda_node_env                      = "production"
lambda_log_level                     = "info"

# SCRUM-40 — AI enrichment after automatic incident create (create-before-analyze).
# Requires Bedrock model access in this account/region.
incident_analyzer = "bedrock"
bedrock_model_id  = "amazon.nova-lite-v1:0"
# Optional: override derived foundation-model ARN(s), e.g. inference-profile ARNs:
# bedrock_invoke_resource_arns = [
#   "arn:aws:bedrock:us-east-1:123456789012:inference-profile/...",
# ]

# SCRUM-41 — SNS incident notifications (processor only).
incident_notifier = "sns"
# Optional email subscription (leave unset/null for topic-only).
# SNS sends a confirmation email; delivery starts only after ConfirmSubscription.
# Do not commit a personal address — set in local terraform.tfvars or CI input.
# notification_email = "ops@example.com"
