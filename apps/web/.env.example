# Public frontend configuration (not a secret).
#
# Local development (default): relative path through the Vite proxy → Fastify.
# Leave unset or set to /api for same-origin calls via apps/web/vite.config.ts.
#
# Production / CloudFront build: set to Terraform output `api_invoke_url`
# (API Gateway base URL, no trailing slash). Example:
#   cd infrastructure/terraform/environments/dev
#   terraform output -raw api_invoke_url
# Then either:
#   export VITE_API_BASE_URL="$(terraform output -raw api_invoke_url)"
#   npm run build:web
# or create a gitignored apps/web/.env.production with:
#   VITE_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
#
# Do not put AWS credentials or secrets in VITE_* variables.
#
# Operator sign-in (Cognito public IDs, not secrets). Required for a gated UI:
#   VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
#   VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#   VITE_COGNITO_REGION=us-east-1
# Copy from: terraform output -raw cognito_user_pool_id / cognito_user_pool_client_id
#
# Examples:
#   VITE_API_BASE_URL=/api
#   VITE_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=/api
