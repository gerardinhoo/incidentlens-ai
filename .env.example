# API / local runtime configuration (not secrets).
#
# Copy to a gitignored `.env` if you prefer file-based local config, or export
# variables in your shell before `npm run dev`.

# Controlled incident-candidate demo endpoint (GET /test-error).
# Default: disabled. Set true only for local pipeline demos.
ENABLE_TEST_ERROR_ENDPOINT=true

# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# INCIDENT_REPOSITORY=memory
# AWS_REGION=us-east-1
# DYNAMODB_INCIDENTS_TABLE=
# DYNAMODB_ENDPOINT=
